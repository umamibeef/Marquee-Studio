+/* VPP and supply VCC codes as the parameter tables list them. On the TL866A/CS
+ * both are nibbles of voltages.vpp (see flags.nibble_voltages). */
+static uint8_t vpp_code(const device_t *device)
+{
+	return device->flags.nibble_voltages ? device->voltages.vpp & 0xf0 :
+					       device->voltages.vpp;
+}
+
+/* TL866A/CS only: the supply VCC the programmer applies (low nibble of the
+ * voltages low byte). The VDD write / VCC verify codes stay in vdd/vcc. */
+static uint8_t supply_vcc_code(const device_t *device)
+{
+	return device->voltages.vpp & 0x0f;
+}
+
+/* Set VPP from a parameter name, keeping the TL866A supply VCC nibble */
+static int set_vpp(minipro_handle_t *handle, char *value, uint8_t type)
+{
+	device_t *device = handle->device;
+	uint8_t v;
+
+	if (set_parameter(handle, value, &v, type))
+		return EXIT_FAILURE;
+	if (device->flags.nibble_voltages)
+		device->voltages.vpp = (device->voltages.vpp & 0x0f) |
+				       (v & 0xf0);
+	else
+		device->voltages.vpp = v;
+	return EXIT_SUCCESS;
+}
+
+/* Set VCC from a parameter name. On the TL866A/CS the supply VCC the programmer
+ * applies is the low nibble of voltages.vpp, so it is set too (upstream #375:
+ * --vcc only changed the verify code and had no effect on the supply). */
+static int set_vcc(minipro_handle_t *handle, char *value, uint8_t type)
+{
+	device_t *device = handle->device;
+	uint8_t v;
+
+	if (set_parameter(handle, value, &v, type))
+		return EXIT_FAILURE;
+	if (device->flags.nibble_voltages && type != LOGIC_VOLTAGE)
+		device->voltages.vpp = (device->voltages.vpp & 0xf0) |
+				       (v & 0x0f);
+	device->voltages.vcc = v;
+	return EXIT_SUCCESS;
+}
+
