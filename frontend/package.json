{
  "name": "marquee-frontend",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @marquee/studio",
    "build": "npm run build -w @marquee/studio",
    "typecheck": "tsc --noEmit -p apps/studio && tsc --noEmit -p packages/sign-player && tsc --noEmit -p packages/ui && tsc --noEmit -p packages/sign-emu",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run build",
    "shots": "node scripts/screenshots.mjs",
    "readme-demo": "npm run build && node scripts/readme-demo.mjs",
    "test": "npm test -w @marquee/sign-emu"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "type": "module"
}
